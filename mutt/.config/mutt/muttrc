## vim: filetype=neomuttrc
# NeoMutt global settings
set editor = "nvim +':set textwidth=0'"
source ~/.config/mutt/default.muttrc
set mbox_type = Maildir
set folder = "~/.local/share/mail"
set spoolfile = "~/.local/share/mail/didousidali@gmail.com/INBOX"  # Default to Gmail inbox

# Enable IMAP IDLE
set imap_idle = yes
set mail_check = 60  # Check for new mail in non-IDLE folders every 60 seconds

# Account switching keybindings
macro index G "<enter-command>source ~/.config/mutt/gmail.muttrc<enter>" "Switch to Gmail account"
macro index U "<enter-command>source ~/.config/mutt/univ.muttrc<enter>" "Switch to University account"

# Default to Gmail on startup
source ~/.config/mutt/gmail.muttrc
